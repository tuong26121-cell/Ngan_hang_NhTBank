{
  "name": "nhtbank",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend --config vite.config.js --host 0.0.0.0",
    "build": "vite build frontend --config vite.config.js",
    "preview": "vite preview frontend --config vite.config.js --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,css,html}\" \"*.js\" \"*.json\" \"*.md\" \"backend/*.md\" \"docs/*.md\" \"e2e/*.js\""
  },
  "dependencies": {
    "canvas-confetti": "1.9.3",
    "framer-motion": "11.18.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
