    "version": "1.0.0-draft.1",
    "description": "Bản nháp máy đọc được để review/fixtures. Chỉ /healthz có implementation gateway hiện hữu; /v1 chưa được phục vụ. Schema validation không chứng minh AuthN/AuthZ, ledger, SQL hoặc concurrency hoạt động."
  },
  "x-contract-status": "PROPOSED",
  "x-source-main": "7192af6c28b51b56806b0b9c6827d2d0604bbc8a",
  "x-open-decisions": [
    {
      "id": "AUTH-ISSUER",
      "blocking": "activation",
      "decision": "Chưa chốt issuer/audience/algorithms/JWKS trust/claim mapping/session expiry/revocation; chưa có JWT verifier app."
    },
    {
      "id": "TRANSFER-CONFIRMATION",
      "blocking": "activation",
      "decision": "Chưa chốt server confirmation ceremony/token; PIN demo123456 không phải ngân hàng, không được coi là xác thực server."
    },
    {
      "id": "LEDGER-STORAGE",
      "blocking": "integration",
      "decision": "Chưa có schema ledger/internal balance và migration được nghiệm thu; SQL v2 import không làm ledger."
    },
    {
      "id": "RETENTION-REPLAY",
      "blocking": "integration",
      "decision": "TTL/retention/replay horizon, cleanupstarted và terminal failure replay chưa chốt; không cài scheduler/cleanup."
    },
    {
      "id": "PRODUCT-FEE",
      "blocking": "release",
      "decision": "Chính sách phí/lãi chưa cung cấp; không tự tạo fee field/chuyển tiền thật."
    },
    {
      "id": "CURSOR-TRUST",
      "blocking": "integration",
      "decision": "Cần chốt ký/expiry và bindingcursor với principal/filter để chặn tampering."
    }
  ],
  "x-design-decisions": {
