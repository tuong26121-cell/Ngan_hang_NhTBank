{
  "name": "nhtbank",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend --config vite.config.js --host 127.0.0.1",
    "build": "vite build frontend --config vite.config.js",
    "preview": "vite preview frontend --config vite.config.js --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,css,html}\" \"packages/**/*.js\" \"backend/**/*.{js,md}\" \"*.js\" \"*.json\" \"*.md\" \"docs/*.md\" \"e2e/*.js\"",
    "platform:serve": "node backend/src/server.js",
    "test:platform": "node --test --test-isolation=none backend/tests/*.test.js"
  },
  "dependencies": {
    "canvas-confetti": "1.9.3",
    "framer-motion": "11.18.2",
    "lucide-react": "0.468.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
