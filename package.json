{
  "name": "nhtbank",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite frontend --config vite.config.js --host 127.0.0.1",
    "build": "vite build frontend --config vite.config.js",
    "preview": "vite preview frontend --config vite.config.js --host 127.0.0.1",
    "test": "vitest run",
    "test:backend": "node --test backend/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,css,html}\" \"*.js\" \"*.json\" \"*.md\" \"backend/*.md\" \"docs/*.md\" \"e2e/*.js\"",
    "test:hop-dong": "node --test scripts/kiem-thu/hop-dong-api.test.mjs",
    "kiem-tra:api": "node scripts/kiem-tra-hop-dong-api.mjs"
  },
  "dependencies": {
    "canvas-confetti": "1.9.3",
    "framer-motion": "11.18.2",
    "jose": "6.1.3",
    "jsqr": "1.4.0",
    "lucide-react": "0.468.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@capacitor/android": "7.6.10",
    "@capacitor/cli": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
